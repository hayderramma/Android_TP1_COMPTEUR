<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_app"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valeur_initiale"
        android:textSize="48sp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonDecrementer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bouton_decrementer"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/buttonIncrementer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bouton_incrementer" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bouton_reinitialiser"
        android:layout_marginTop="24dp" />

</LinearLayout>